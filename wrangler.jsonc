{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-master",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // 画面などの静的ファイル(リクエストは無料・無制限)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // AI発音チェック・AI英会話に使う Workers AI(1日10,000 Neuronsまで無料)
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
